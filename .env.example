# Backend URL used by Next.js rewrites to proxy /api/* requests.
#
# IMPORTANT: next.config.ts bakes this into .next/routes-manifest.json during
# `next build`. Changing it at runtime (or in a .env read by `next start`) has
# NO effect — the proxy keeps hitting the old URL and the API returns 5xx.
# It MUST be set before building:  BACKEND_URL=http://127.0.0.1:8081 npm run build
#
# Start the Laravel API on this port first: php artisan serve --port=8081
BACKEND_URL=http://127.0.0.1:8081
